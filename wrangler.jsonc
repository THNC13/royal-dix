{
  // Deploys the whole folder as a static site on Cloudflare (Workers with static assets).
  // Only /api/* runs code (the optional rules assistant); everything else is served as plain files.
  "name": "royal-dix",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // Photo album storage (Memories page)
  "kv_namespaces": [{ "binding": "PHOTOS", "id": "4339f63e854f40368bbda548ac783aa2" }],
  // Free rules assistant (Cloudflare Workers AI). Used when no ANTHROPIC_API_KEY secret is set.
  "ai": { "binding": "AI" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
